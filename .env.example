# ─── Backend ───────────────────────────────────────────────────────────────
# Pinata IPFS
PINATA_JWT=your_pinata_jwt_here
PINATA_GATEWAY=https://gateway.pinata.cloud

# Key encryption — 32-byte hex secret used to wrap AES keys server-side
KEY_WRAP_SECRET=replace_with_32_byte_hex_secret_here

# Allowed CORS origin (your frontend URL)
CORS_ORIGIN=http://localhost:5173

# ─── AI Service ─────────────────────────────────────────────────────────────
# OpenAI (optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (optional alternative)
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Frontend (Vite) ────────────────────────────────────────────────────────
# Only non-secret values go here — never put keys or JWTs in VITE_ variables
VITE_CONTRACT_ADDRESS=0xYourDeployedContractAddressHere
VITE_CHAIN_ID=31337
VITE_BACKEND_URL=http://localhost:8000
VITE_AI_SERVICE_URL=http://localhost:8001
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud
